{
  "name": "@mentio-dev/cli",
  "version": "0.7.0",
  "description": "Command-line client for the Mentio API: one command per endpoint, plus watch and MCP helpers.",
  "license": "MIT",
  "homepage": "https://docs.mentio.dev/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mentio-dev/cli.git"
  },
  "bugs": {
    "url": "https://github.com/mentio-dev/cli/issues"
  },
  "keywords": [
    "mentio",
    "social listening",
    "brand monitoring",
    "cli",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "mentio": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "tsx scripts/generate-operations.ts",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@mentio-dev/sdk": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
